# Copy this file to .env and replace the password and secret placeholders.
# Your real .env is private and is excluded from Git.
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgresql_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=school_management

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_generated_random_secret
PORT=5000

# Optional Gmail configuration for credential and password-reset emails.
# Enable two-step verification and use a Google App Password.
# EMAIL_USER=your_test_account@gmail.com
# EMAIL_PASS=your_google_app_password
# EMAIL_FROM=your_test_account@gmail.com

# Optional: restrict direct browser requests to this frontend origin.
# FRONTEND_URL=http://localhost:3000
